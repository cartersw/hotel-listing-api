@HotelListing.Api_HostAddress = https://localhost:7041



GET {{HotelListing.Api_HostAddress}}/api/countries

###

POST {{HotelListing.Api_HostAddress}}/api/countries
Content-Type: application/json

{
  "name": "Test country 4",
  "shortName": "TC4"
}

###

DELETE {{HotelListing.Api_HostAddress}}/api/countries/{{countryid}}

###

@countryid = 3
GET {{HotelListing.Api_HostAddress}}/api/countries/{{countryid}}

###


GET {{HotelListing.Api_HostAddress}}/api/countries/3

###

PUT {{HotelListing.Api_HostAddress}}/api/countries/{{countryid}}
Content-Type: application/json

{
  "countryId": 2,
  "name": "Countryia",
  "shortName": "CRI"
}

###

GET {{HotelListing.Api_HostAddress}}/api/hotels

###

POST {{HotelListing.Api_HostAddress}}/api/hotels
Content-Type: application/json

{
  "Name": "Dto Test Hotel",
  "Address": "Test",
  "Rating": 4.9,
  "CountryId": 2
}

###


DELETE {{HotelListing.Api_HostAddress}}/api/hotels/{{id}}

###
@id=5
GET {{HotelListing.Api_HostAddress}}/api/hotels/{{id}}

###

PUT {{HotelListing.Api_HostAddress}}/api/hotels/{{id}}
Content-Type: application/json

{
  "Id": 5,
  "Name": "I changed this hotel",
  "Address": "Test a change",
  "Rating": 4.25,
  "CountryId": 2
}

