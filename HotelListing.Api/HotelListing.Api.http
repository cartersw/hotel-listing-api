@HotelListing.Api_HostAddress = https://localhost:7041




GET {{HotelListing.Api_HostAddress}}/api/country

###

POST {{HotelListing.Api_HostAddress}}/api/country
Content-Type: application/json

{
  "name": "Test country with dto and service layer 3",
  "shortName": "s3"
}

###

DELETE {{HotelListing.Api_HostAddress}}/api/country/{{countryId}}

###

@countryId=6
GET {{HotelListing.Api_HostAddress}}/api/country/{{countryId}}

###

PUT {{HotelListing.Api_HostAddress}}/api/country/{{countryId}}
Content-Type: application/json

{
  "countryId": 6,
  "name": "I edited this country with a service layer",
  "shortName": "ec6"
}

###

POST {{HotelListing.Api_HostAddress}}/api/hotel
Content-Type: application/json

{
  "Name": "hotel blue",
  "Address": "Test blue",
  "Rating": 4.5,
  "CountryId": 6
}

###

DELETE {{HotelListing.Api_HostAddress}}/api/hotel/{{id}}

###

@id=5
GET {{HotelListing.Api_HostAddress}}/api/hotel/{{id}}

###

PUT {{HotelListing.Api_HostAddress}}/api/hotel/{{id}}
Content-Type: application/json

{
  "Id": 5,
  "Name": "I changed this hotel",
  "Address": "Test a change",
  "Rating": 4.25,
  "CountryId": 2
}

